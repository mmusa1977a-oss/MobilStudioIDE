<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Üst Menü -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MobilStudio IDE"
            android:textColor="#111827"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Aç"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Kaydet"/>

        <Button
            android:id="@+id/btnBuild"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Derle"/>

    </LinearLayout>

    <!-- Dosya Yolu -->

    <EditText
        android:id="@+id/etFilePath"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/topBar"
        android:layout_margin="8dp"
        android:background="#FFFFFF"
        android:hint="app/src/main/res/layout/activity_main.xml"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#111827"
        android:textColorHint="#808080"/>

    <!-- Kod Editörü -->

    <ScrollView
        android:id="@+id/codeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/etFilePath"
        android:layout_above="@id/statusBar"
        android:fillViewport="true">

        <EditText
            android:id="@+id/etCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minHeight="1000dp"
            android:padding="16dp"
            android:textColor="#111827"
            android:textSize="14sp"/>

    </ScrollView>

    <!-- Sürüklenebilir Telefon -->

    <LinearLayout
        android:id="@+id/floatingPreview"
        android:layout_width="160dp"
        android:layout_height="300dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:background="#000000"
            android:gravity="center"
            android:text="12:00"
            android:textColor="#FFFFFF"
            android:textSize="9sp"/>

        <FrameLayout
            android:id="@+id/phoneCanvas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:background="#000000"
            android:gravity="center"
            android:text="◄   ●   ■"
            android:textColor="#FFFFFF"
            android:textSize="9sp"/>

    </LinearLayout>

    <!-- Alt Durum Çubuğu -->

    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hazır"
            android:textColor="#555555"
            android:textSize="13sp"/>

    </LinearLayout>

</RelativeLayout>
